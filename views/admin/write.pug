					.picedit_canvas_box
						.picedit_painter
							canvas
						.picedit_canvas
							canvas
						.picedit_action_btns.active
							.picedit_control.ico-picedit-picture(data-action='load_image')
							.picedit_control.ico-picedit-camera(data-action='camera_open')
							.center or copy/paste image here
					// Picedit Video Box
