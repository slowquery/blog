						video(autoplay='')
						.picedit_video_controls
							span.picedit_control.picedit_action.ico-picedit-checkmark(data-action='take_photo')
							span.picedit_control.picedit_action.ico-picedit-close(data-action='camera_close')
					// Picedit draggable and resizeable div to outline cropping boundaries
					.picedit_drag_resize
						.picedit_drag_resize_canvas
						.picedit_drag_resize_box
							.picedit_drag_resize_box_corner_wrap
								.picedit_drag_resize_box_corner
							.picedit_drag_resize_box_elements
								span.picedit_control.picedit_action.ico-picedit-checkmark(data-action='crop_image')
								span.picedit_control.picedit_action.ico-picedit-close(data-action='crop_close')
				// end_picedit_box
			div(style='margin-top:30px; text-align: center;')
