extends header.pug
block title
	title 블로그 admin
block scripts
	link(rel='stylesheet', href='/css/font.css')
	link(rel='stylesheet', href='/css/picedit.css')
	link(rel='stylesheet', href='https://cdn.jsdelivr.net/simplemde/latest/simplemde.min.css')
	script(src='https://cdn.jsdelivr.net/simplemde/latest/simplemde.min.js')
	script(src='/js/picedit.js')
block content
	if post
		script.
			$(document).ready(function(){
				function b64_to_utf8( str ) {
				    return decodeURIComponent(escape(window.atob( str )));
				}
				function uploadFile(){
					var form = $('.upload')[0];
					var formData = new FormData(form);
					formData.append("file", $(".file")[0].files[0]);

					$.ajax({
						url: "/admin/upload",
						processData: false,
						contentType: false,
						data: formData,
						type: 'POST',
					})
					.done(function(data){
						if(data["code"] === 200)
							$(".return").text(data["filename"]);
						else
							$(".return").text("파일 업로드 실패");
					});
				}
				var simplemde = new SimpleMDE({element: $("#md-content")[0]});
				$('.picedit_box').picEdit({
					imageUpdated: function(img){
					},
					formSubmitted: function(data){
						$(".return").text(JSON.parse(data["response"])["filename"]);
					},
					redirectUrl: false,
					defaultImage: false
				});

				$(".mdecontent").click(function(){
					$.ajax({
						url: "/admin/post",
						type: "POST",
						data: "title=" + $("input[name='title']").val() + "&description=" + $("input[name='description']").val() + "&password=" + $("input[name='password']").val() + "&tag=" + $("input[name='tag']").val() + "&bgcolor=" + $("select[name='bgcolor']").val() + "&thumbnail=" + $("input[name='thumbnail']").val() + "&content=" + simplemde.value() + "&type=write",
					})
					.done(function(data) {
						if(data["code"] === 200)
							location.href = "/admin/main";
						else
							alert(data["code"]);
					});
				});
				function save() {
					$.ajax({
						url: "/admin/post",
						type: "POST",
						data: "title=" + $("input[name='title']").val() + "&description=" + $("input[name='description']").val() + "&password=" + $("input[name='password']").val() + "&tag=" + $("input[name='tag']").val() + "&bgcolor=" + $("select[name='bgcolor']").val() + "&thumbnail=" + $("input[name='thumbnail']").val() + "&content=" + simplemde.value() + "&type=save",
					})
					.done(function(data) {
						console.log(data);
					});
				}
				setInterval(function() {
					save();
				}, 1000 * 60);
				$(".save-btn").click(function(){
					save();
				});
				$(".save-load").click(function() {
					$.ajax({
						url: "/admin/save",
						type: "GET"
					})
					.done(function(data) {
						if(data["code"] === 200) {
							$("input[name='title']").val(data["data"]["title"]);
							$("input[name='description']").val(data["data"]["description"]);
							$("input[name='password']").val(data["data"]["password"]);
							$("input[name='tag']").val(data["data"]["tag"].toString());
							$("select[name='bgcolor']").val(data["data"]["bgcolor"]);
							$("input[name='thumbnail']").val(data["data"]["thumbnail"]);
							simplemde.value(b64_to_utf8("#{post["content"]}"));
						}
					});
				});

				$("input[name='title']").val("#{post["title"]}");
				$("input[name='description']").val("#{post["description"]}");
				$("input[name='password']").val("#{post["password"]}");
				$("input[name='tag']").val("#{post["tag"]}");
				$("select[name='bgcolor']").val("#{post["bgcolor"]}");
				$("input[name='thumbnail']").val("#{post["thumbnail"]}");
				simplemde.value(b64_to_utf8("#{post["content"]}"));
				$(".mdecontent-edit").click(function(){
					$.ajax({
						url: "/admin/post",
						type: "POST",
						data: "title=" + $("input[name='title']").val() + "&description=" + $("input[name='description']").val() + "&password=" + $("input[name='password']").val() + "&tag=" + $("input[name='tag']").val() + "&bgcolor=" + $("select[name='bgcolor']").val() + "&thumbnail=" + $("input[name='thumbnail']").val() + "&content=" + simplemde.value() + "&type=edit" + "&id=" + "#{id}",
					})
					.done(function(data) {
						if(data["code"] === 200)
							location.href = "/admin/main";
						else
							alert(data["code"]);
					});
				});
				$(".fileupload-btn").click(function(){
					uploadFile();
				});
			});
	else
