	.container.pt-4.pb-4.login
		if mode === "write"
			h1 글쓰기
		else
			h1 글편집
		button.save-btn.btn.btn-primary 글 저장
		button.save-load.btn.btn-primary 글 불러오기
		div.form-group
			label(for="formGroupExampleInput") 글 제목
			input.form-control(type="text", placeholder="글 제목", name="title")
		div.form-group
			label(for="formGroupExampleInput") 글 설명
			input.form-control(type="text", placeholder="글 설명", name="description")
		div.form-group
			label(for="formGroupExampleInput") 글 비밀번호
			input.form-control(type="password", placeholder="글 비밀번호(없으면 공백)", name="password")
		div.form-group
			label(for="formGroupExampleInput") 글 태그
			input.form-control(type="text", placeholder="글 태그", name="tag")
		div.form-group
			label(for="formGroupExampleInput") 글 배경색
			select.form-control(name="bgcolor")
				option(value="") 선택
				option(value="#3cce5f") #3cce5f (연두색)
				option(value="#dd528b") #dd528b (분홍색)
				option(value="#ff8155") #ff8155 (주황색)
				option(value="#42a5f5") #42a5f5 (파란색)
		div.form-group
			label(for="formGroupExampleInput") 글 배경 사진 이름
			input.form-control(type="text", placeholder="글 배경 사진 이름(확장자 포함)", name="thumbnail")
		//button.mdecontent.btn.btn-primary(type="submit") 글쓰기
		form(name='asyncimage', action='/admin/upload', method='post', enctype='multipart/form-data')
			div(style='margin:4% auto 0 auto; display: table;')
				// begin_picedit_box
				.picedit_box
					// Placeholder for messaging
					.picedit_message
						span.picedit_control.ico-picedit-close(data-action='hide_messagebox')
						div
					// Picedit navigation
					.picedit_nav_box.picedit_gray_gradient
						.picedit_pos_elements
						.picedit_nav_elements
							// Picedit button element begin
							.picedit_element
								span.picedit_control.picedit_action.ico-picedit-pencil(title='Pen Tool')
								.picedit_control_menu
									.picedit_control_menu_container.picedit_tooltip.picedit_elm_3
										label.picedit_colors
											span.picedit_control.picedit_action.picedit_black.active(title='Black', data-action='toggle_button', data-variable='pen_color', data-value='black')
											span.picedit_control.picedit_action.picedit_red(title='Red', data-action='toggle_button', data-variable='pen_color', data-value='red')
											span.picedit_control.picedit_action.picedit_green(title='Green', data-action='toggle_button', data-variable='pen_color', data-value='green')
										label
											span.picedit_separator
										label.picedit_sizes
											span.picedit_control.picedit_action.picedit_large(title='Large', data-action='toggle_button', data-variable='pen_size', data-value='16')
											span.picedit_control.picedit_action.picedit_medium(title='Medium', data-action='toggle_button', data-variable='pen_size', data-value='8')
											span.picedit_control.picedit_action.picedit_small(title='Small', data-action='toggle_button', data-variable='pen_size', data-value='3')
							// Picedit button element end
							// Picedit button element begin
							.picedit_element
								span.picedit_control.picedit_action.ico-picedit-insertpicture(title='Crop', data-action='crop_open')
							// Picedit button element end
							// Picedit button element begin
							.picedit_element
								span.picedit_control.picedit_action.ico-picedit-redo(title='Rotate')
								.picedit_control_menu
									.picedit_control_menu_container.picedit_tooltip.picedit_elm_1
										label
											span 90° CW
											span.picedit_control.picedit_action.ico-picedit-redo(data-action='rotate_cw')
										label
											span 90° CCW
											span.picedit_control.picedit_action.ico-picedit-undo(data-action='rotate_ccw')
							// Picedit button element end
							// Picedit button element begin
							.picedit_element
								span.picedit_control.picedit_action.ico-picedit-arrow-maximise(title='Resize')
								.picedit_control_menu
									.picedit_control_menu_container.picedit_tooltip.picedit_elm_2
										label
											span.picedit_control.picedit_action.ico-picedit-checkmark(data-action='resize_image')
											span.picedit_control.picedit_action.ico-picedit-close(data-action='')
										label
											span Width (px)
											input.picedit_input(type='text', data-variable='resize_width', value='0')
										label.picedit_nomargin
											span.picedit_control.ico-picedit-link(data-action='toggle_button', data-variable='resize_proportions')
										label
											span Height (px)
											input.picedit_input(type='text', data-variable='resize_height', value='0')
							// Picedit button element end
