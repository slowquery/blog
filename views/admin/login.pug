extends header.pug
block title
	title 블로그 admin
block scripts
	link(rel='stylesheet', href='/css/admin.css')
block content
		.container.pt-4.login
			h1 로그인
			div.row.justify-content-md-center
				div.col-12.col-md-auto
					form(action="/admin/login", method="POST")
						div.form-group
							label(for="formGroupExampleInput") ID
							input.form-control(type="text", placeholder="ID", name="user_id")
						div.form-group
							label(for="formGroupExampleInput") PW
							input.form-control(type="password", placeholder="PW", name="user_pass")
						button.btn.btn-primary(type="submit") Login