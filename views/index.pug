extends header.pug
block title
	title antiweb 기술 블로그
block scripts
	script(src='/js/index.js')
block content
		.jumbotron.jumbotron-fluid.title-logo
			.containter.text-center
				.main-logo-nav
					img.main-logo(src='image/logo_w.svg')
					p Technical blog.
		.container
			.my-profile
				img(src='image/profile.png')
				.profile-editor
					.editor
						span.white Editor:
						|  antiweb
					.introduce 이곳은 너가 얼마나 자랑스러운지 자랑하는 자기소개 부분임
			.post.mt-4.mb-4
				.row
					each data in post
						.post-cardlist.col-md-4(data-id=`${data["_id"]}`)
							.card
								.card.card-inverse
									a(href=`/view/${data["_id"]}/`)
										if data["bgcolor"] !== null
											.post-card(style=`background-color: ${data["bgcolor"]}`)
										else
											.post-card(style=`background-image: url(/image/${data["thumbnail"]})`)
										.card-img-overlay
											span #{moment(new Date(data["time"])).format("YYYY.MM.DD")}
											.post-content
												.post-title #{data["title"]}
												.post-description #{data["description"]}
					.loading.col-4.mx-auto.text-center
						img(src='/image/loading.gif')
		include footer.pug