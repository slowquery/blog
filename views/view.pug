extends header.pug
block title
	title slowquery 기술 블로그
block scripts
	meta(property='og:title', content=`${title ? title : post["title"]}`)
	meta(property='og:description', content=`${post ? post["description"] : "Locked!"}`)
	script(src='/js/zoom.js')
	link(rel='stylesheet', href='/highlight/styles/androidstudio.css')
	script(src='/highlight/highlight.pack.js')
	script(src='/js/view.js')
	script.
		hljs.initHighlightingOnLoad();
block content
	script.
		$(document).ready(function(){
			function comment() {
				$.ajax({
					url: "/api/comment",
					type: "POST",
					data: "user_name=" + $("input[name='name']").val() + "&content=" + $("textarea[name='comment']").val() + "&post=" + location.pathname.slice(6, -1),
					error: function() {
						location.href = "/";
					}
				})
				.done(function(data){
					if(data["code"] === 200) {
						$(".comment-real-count").text(Number($(".comment-real-count").text()) + 1);
						$(".comment-list.mt-4").append("<div class='real-comment'><div class='real-comment-name'>" + data["data"]["user_name"] + "</div><div class='real-comment-main'>" + data["data"]["content"] + "</div><hr class='my-1 mt-3 mb-3'></div>");
						$("input[name='name']").val('');
						$("textarea[name='comment']").val('');
					}
					else
						location.href = "/";
				});
			}
			$(".comment-send").click(function(){
				comment();
			});
			$("textarea[name='comment']").keyup(function(e){
				if(e.keyCode == 13) comment();
			});
		});
	.post-main.container
		if post
			.post-main-wrapper.container
				.main-title #{post["title"]}
				.main-description #{post["description"]}
				.main-time #{moment(new Date(post["time"])).format("YYYY.MM.DD HH:mm:ss")}
			hr.my-4
			.main-content.container
				!=post["content"]
				div.tag
					span.badge.badge-pill.badge-default.tag-default 태그
					each tag in post["tag"]
						span.badge.badge-success #{tag}
			hr.my-4
			.main-comment.container
				.comment-count 댓글 
					span.comment-real-count #{post["comment"] ? post["comment"].length : 0}
				.comment-input
					.comment-name
						input(type='text', placeholder='작성자 이름', name='name')
					hr.comment-hr.mt-1.mb-1
					.comment-main
						textarea.comment-scroll(placeholder='댓글 쓰기', name='comment')
					.comment-notice
						.comment-notice-text enter로 전송, shift+enter로 줄바꿈이 가능합니다.
						button.comment-send 전송
			.comment-list.mt-4.container
				each comment in post["comment"]
					.real-comment
						.real-comment-name #{comment["user_name"]}
						.real-comment-main #{comment["content"]}
						hr.my-1.mt-3.mb-3
		else
			script.
				$(document).ready(function(){
					function auth() {
						$.ajax({
							url: "/api/auth",
							type: "POST",
							data: "password=" + $("input[name='password']").val() + "&key=" + $(".password-auth").attr("key"),
							error: function() {
								location.href = "/";
							}
						})
						.done(function(data){
							if(data["code"] === 200)
								location.reload();
							else
								location.href = "/";
						});
					}
					$(".auth-btn").click(function(){
						auth();
					});
					$("input[name='password']").keyup(function(e){
						if(e.keyCode == 13) auth();
					});
				});
			.text-center
				h1.pt-4.pb-4 Locked!
				div.row.justify-content-md-center
					div.col-12.col-md-auto
						.password-auth(key=`${id}`)
							div.form-group
								label(for="formGroupExampleInput") PASSWORD
								input.form-control(type="password", placeholder="PASSWORD", name="password")
							button.auth-btn.btn.btn-primary(type="button") AUTH
	include footer.pug
