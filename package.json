{
  "name": "imustdo.work-blog",
  "version": "1.1.2",
  "description": "my blog",
  "main": "server.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "node server.js",
    "start": "node server.js",
    "harbor:project": "bash deploy/scripts/harbor-project-apply.sh",
    "helm:devtool:secrets": "bash helm/devtool/scripts/devtool-secrets-generate.sh",
    "helm:devtool:secrets:force": "DEVTOOL_SECRETS_FORCE=1 bash helm/devtool/scripts/devtool-secrets-generate.sh",
    "helm:devtool:install:mongodb": "bash helm/devtool/scripts/install.sh mongodb",
    "deploy:mongodb:restore": "bash deploy/scripts/mongodb-restore-dump.sh",
    "deploy:upload:sync": "bash deploy/scripts/upload-sync.sh",
    "deploy:verify": "bash deploy/scripts/verify-service.sh",
    "deploy:finish": "bash deploy/scripts/finish-migration.sh",
    "deploy:secrets": "bash deploy/scripts/sync-app-secrets.sh",
    "deploy:argocd": "bash deploy/scripts/apply-argocd-apps.sh",
    "deploy:argocd:repo": "bash deploy/scripts/argocd-repo-secret-apply.sh",
    "deploy:gateway-hosts": "bash deploy/scripts/gateway-hosts-apply.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/antiwebkr/myblog.git"
  },
  "keywords": [
    "myblog"
  ],
  "author": "antiweb@noe.systems",
  "license": "MIT",
  "homepage": "https://bitbucket.org/antiwebkr/myblog#readme",
  "dependencies": {
    "htmldom": "^1.0.1",
    "joi": "^13.1.1",
    "koa": "^2.4.1",
    "koa-body": "^2.5.0",
    "koa-bodyparser": "^4.2.0",
    "koa-generic-session": "^2.0.1",
    "koa-json": "^2.0.2",
    "koa-mount": "^3.0.0",
    "koa-pug": "^3.0.0-2",
    "koa-redis": "^3.1.2",
    "koa-router": "^7.3.0",
    "koa-static": "^4.0.2",
    "lodash": "^4.17.4",
    "marked": "^0.3.12",
    "moment": "^2.20.1",
    "mongoose": "^5.6.9",
    "mv": "^2.1.1",
    "xss": "^0.3.7"
  }
}
